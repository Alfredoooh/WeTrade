<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.wilin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#1C1C1E</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorSurfaceVariant">#2C2C2E</item>
        <item name="colorOnSurfaceVariant">#ABABAB</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#1C1C1E</item>
        <item name="android:windowBackground">@color/background_dark</item>
    </style>

    <style name="Theme.wilin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.wilin</item>
    </style>
</resources>