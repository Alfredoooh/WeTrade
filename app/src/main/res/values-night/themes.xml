<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.wesports" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#007AFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">#007AFF</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowBackground">@color/splash_background_dark</item>
    </style>
    <style name="Theme.wesports.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.wesports</item>
    </style>
</resources>