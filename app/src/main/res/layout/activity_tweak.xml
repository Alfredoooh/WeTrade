<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#007AFF"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#007AFF"
            app:title="Novo Tweak"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@drawable/ic_arrow_back" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nome -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nome do Tweak"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="text"
                android:textColor="#111111"
                android:textSize="15sp"
                android:backgroundTint="#007AFF"
                android:paddingStart="0dp"
                android:hint="ex: Unitel Free"
                android:layout_marginBottom="20dp" />

            <!-- Modo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo de Ligação"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp" />

            <!-- SNI (só para SSL) -->
            <LinearLayout
                android:id="@+id/layoutSni"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SNI Host"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerSni"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etSniCustom"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="SNI personalizado (opcional)"
                    android:inputType="textUri"
                    android:textColor="#111111"
                    android:textSize="14sp"
                    android:backgroundTint="#007AFF"
                    android:paddingStart="0dp"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>

            <!-- Payload HTTP -->
            <LinearLayout
                android:id="@+id/layoutPayload"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HTTP Payload"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etPayload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="GET / HTTP/1.1[crlf]Host: [host][crlf][crlf]"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top"
                    android:textColor="#111111"
                    android:textSize="13sp"
                    android:backgroundTint="#007AFF"
                    android:paddingStart="0dp"
                    android:fontFamily="monospace"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Variáveis: [host] [port] [crlf] [cr] [lf]"
                    android:textSize="11sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginBottom="20dp" />

            </LinearLayout>

            <!-- Tipo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de Protocolo"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="24dp" />

            <!-- Extras -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opções Extras"
                android:textSize="12sp"
                android:textColor="#888888"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <CheckBox
                android:id="@+id/cbMobileData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apenas dados móveis"
                android:textColor="#333333"
                android:buttonTint="#007AFF"
                android:layout_marginBottom="6dp" />

            <CheckBox
                android:id="@+id/cbBlockRooted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bloquear dispositivos rooted"
                android:textColor="#333333"
                android:buttonTint="#007AFF"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Guardar Tweak"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#007AFF"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>