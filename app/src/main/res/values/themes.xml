<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.wilin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/text_primary_dark</item>
        <item name="android:statusBarColor">@color/appbar_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bottom_nav_background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="bottomNavigationStyle">@style/Widget.BottomNav.Custom</item>
    </style>

    <style name="Theme.wilin.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.wilin</item>
    </style>

    <style name="Widget.BottomNav.Custom" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.BottomNav.Custom</item>
        <item name="itemPaddingTop">4dp</item>
        <item name="itemPaddingBottom">4dp</item>
    </style>

    <style name="ThemeOverlay.BottomNav.Custom" parent="">
        <item name="colorSecondaryContainer">#1A007AFF</item>
        <item name="colorOnSecondaryContainer">@color/colorPrimary</item>
    </style>

    <style name="Theme.wilin.Drawer" parent="Theme.wilin">
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>